# Copy this file to .env and fill in your values. .env is never committed to git.

# Turso database (leave empty to use the local SQLite file data/malcomtrans.sqlite3)
# URL: Turso dashboard -> your database -> "libsql://..."
TURSO_DATABASE_URL=
# Database token (NOT the organisation/platform API token): database -> Create Token
TURSO_AUTH_TOKEN=

# Optional: HERE routing key (alternatively data/here_api_key.txt)
HERE_API_KEY=
